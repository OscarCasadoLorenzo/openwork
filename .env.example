# ============================================================
# Multiagent Work — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to git. It is listed in .gitignore.
# Run `bash scripts/validate.sh` after filling in values.
# ============================================================

# Choose ONE deployment type below and uncomment the relevant section:
# 1. Atlassian Cloud (SaaS)
# 2. Jira Data Center (self-hosted)

# ------------------------------------------------------------
# OPTION 1: Atlassian Cloud (SaaS)
# Required by: confluence subagent, jira subagent, mcp-atlassian
# ------------------------------------------------------------

# Base URL of your Atlassian Cloud instance.
# Format: https://<your-org>.atlassian.net  (no trailing slash)
# ATLASSIAN_URL=https://your-org.atlassian.net

# Email address associated with your Atlassian account.
# ATLASSIAN_EMAIL=your.email@company.com

# Atlassian API token (for Cloud deployments)
# Generate one at: https://id.atlassian.com/manage-profile/security/api-tokens
# Treat this like a password — never share or commit it.
# ATLASSIAN_API_TOKEN=your_atlassian_api_token_here

# ------------------------------------------------------------
# OPTION 2: Jira Data Center (self-hosted)
# Required by: jira subagent, custom atlassian-datacenter MCP server
# ------------------------------------------------------------

# Base URL of your self-hosted Jira Data Center instance.
# Format: https://<your-jira-domain>  (no trailing slash)
JIRA_DC_URL=https://jira.your-company.com

# Personal Access Token (PAT) for Jira Data Center
# Generate one in Jira: Profile > Personal Access Tokens
# Used with Bearer authentication (Authorization: Bearer <token>)
JIRA_DC_PAT=your_jira_datacenter_pat_here

# Set to "false" if your instance uses a self-signed TLS certificate
# Default: true
JIRA_DC_SSL_VERIFY=true
